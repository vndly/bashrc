# usage: search_text "start()" /var/www
function search_text ()
{
    sudo egrep --color -r "$1" "$2"
}

# usage: search_text_simple "start()" /var/www
function search_text_simple ()
{
    sudo egrep --color -rl "$1" "$2"
}

# usage: search_text "start()" php /var/www
function search_text_by_extension()
{
    sudo egrep --color -rn "$1" --include \*."$2" "$3"
}

# usage: search_file index.php /var/www
function search_file()
{
    sudo find "$2" -name "$1"
}

# =============================================================================================

function commit()
{
    git commit -am "$1"
}

function push()
{
    git push
}

function cush()
{
    git commit -am "$1"
    git push
}

function acpe()
{
    msg="${1:-Improvements}"

    git add -A
    git commit -am "$msg"
    git push

    if [ -n "$1" ]; then
        exit
    fi
}

function ace()
{
    git add -A
    git commit -am "$1"
    exit
}

function pull()
{
    git pull
}

function diff()
{
    git diff
}

function status()
{
    git status
}

function add()
{
    git add -A
}

function git_reset_branch()
{
    git reset --hard origin/$1
}

function git_new_branch()
{
    git co -b $1
    git branch --set-upstream-to=origin/$1
}

