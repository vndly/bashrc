# ================================== SEARCH ==================================

# usage: search_text "start()" /home
function search_text () {
  sudo egrep --color -r "$1" "$2"
}

# usage: search_text_simple "start()" /home
function search_text_simple () {
  sudo egrep --color -rl "$1" "$2"
}

# usage: search_text "start()" php /home
function search_text_by_extension () {
  sudo egrep --color -rn "$1" --include \*."$2" "$3"
}

# usage: search_file index.php /home
function search_file () {
  sudo find "$2" -name "$1"
}

# ================================== GIT ==================================

function commit () {
  git commit -am "$1"
}

function push () {
  git push
}

function cush () {
  git commit -am "$1"
  git push
}

function acpe () {
  msg="${1:-Improvements}"

  git add -A
  git commit -am "$msg"
  git push

  if [ -n "$1" ]; then
    exit
  fi
}

function ace () {
  git add -A
  git commit -am "$1"
  exit
}

function pull () {
  git pull
}

function diff () {
  git diff
}

function status () {
  git status
}

function add () {
  git add -A
}

function git_reset_branch () {
  git reset --hard origin/$1
}

function git_new_branch () {
  git co -b $1
  git branch --set-upstream-to=origin/$1
}

# ================================== UTILITIES ==================================

function watchme () {
  cd functions
  npm run check && npm run build:watch
}

function npm_test_by_name () {
  npm test -- -t "$1"
}

function npm_test_full () {
  npm test -- --maxWorkers=50%
}

function base64encode () {
  node -e "console.log(btoa('"$1"'))"
}

function base64decode () {
  node -e "console.log(atob('"$1"'.includes('_') ? '"$1"'.split('_')[1] : '"$1"'))"
}

function timestamp () {
  node -pe "new Date('$1')" | tee /dev/tty | xclip -selection clipboard
}

# ================================== COMMANDS ==================================

alias ..="cd .."
alias ls="ls -la"
alias rm="rm -i"
alias swap_clear="sudo swapoff -a && sudo swapon -a"
alias flutter_clean_pub_cache="dart pub cache gc"

# ================================== UPDATERS ==================================

alias update_claude="curl -fsSL https://claude.ai/install.sh | bash"
alias update_codex="npm install -g @openai/codex"
alias update_agy="agy update"
alias update_firebase="npm install -g firebase-tools"
alias update_npm="npm install -g npm@latest"
alias update_flutter="flutter upgrade --force"
alias update_settings="curl -fsSL https://raw.githubusercontent.com/vndly/claude-code-settings/main/install.sh | bash"
alias update_bashrc="curl -fsSL https://raw.githubusercontent.com/vndly/bashrc/main/install.sh | bash"

# ================================== EXPORTS ==================================

export VISUAL=vim
export EDITOR=vim
export CLAUDE_CODE_EFFORT_LEVEL=max

export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
export FLUTTER_HOME="/opt/Flutter/bin"
export FLUTTER_PUB_HOME="/opt/Flutter/.pub-cache/bin/bin"
export PUB_CACHE="/opt/Flutter/.pub-cache/bin"
export ANDROID_HOME="/opt/AndroidSdk"
export ANDROID_STUDIO_HOME="/opt/AndroidStudio"
export ANDROID_NDK_ROOT="/opt/AndroidSdk/ndk-bundle"
export ANDROID_NDK_HOME="/opt/AndroidSdk/ndk-bundle"
export PRIMAL_INTERPRETER="/home/max/.local/bin"

export PATH="$PATH:$FLUTTER_HOME"
export PATH="$PATH:$ANDROID_HOME"
export PATH="$PATH:$PUB_CACHE"
export PATH="$PATH:$FLUTTER_PUB_HOME"
export PATH="$PATH:$PRIMAL_INTERPRETER"

# =================================== NVM ===================================

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# ================================== CLEAR ==================================

clear