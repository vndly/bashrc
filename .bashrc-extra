# ================================== SEARCH ==================================

# usage: search_text "start()" /home
function search_text () {
  if [ -z "$1" ]; then echo 'usage: search_text "start()" /home' >&2; return 1; fi
  sudo grep -E --color -rnI --exclude-dir={.git,node_modules} -- "$1" "${2:-.}"
}

# usage: search_text_files "start()" /home
function search_text_files () {
  if [ -z "$1" ]; then echo 'usage: search_text_files "start()" /home' >&2; return 1; fi
  sudo grep -E --color -rlI --exclude-dir={.git,node_modules} -- "$1" "${2:-.}"
}

# usage: search_text_by_extension "start()" php /home
function search_text_by_extension () {
  if [ -z "$1" ] || [ -z "$2" ]; then echo 'usage: search_text_by_extension "start()" php /home' >&2; return 1; fi
  sudo grep -E --color -rnI --include="*.$2" --exclude-dir={.git,node_modules} -- "$1" "${3:-.}"
}

# usage: search_file "index.php" /home
function search_file () {
  if [ -z "$1" ]; then echo 'usage: search_file "index.php" /home' >&2; return 1; fi
  sudo find -- "${2:-.}" -name "$1"
}

# ================================== GIT ==================================

function commit () {
  git commit -am "$1"
}

function push () {
  git push
}

function cush () {
  git commit -am "$1"
  git push
}

function acpe () {
  local message="${1:-Improvements}"

  git add -A
  git commit -am "$message"
  git push

  if [ -n "$1" ]; then
    exit
  fi
}

function ace () {
  git add -A
  git commit -am "$1"
  exit
}

function pull () {
  git pull
}

function diff () {
  git diff
}

function status () {
  git status
}

function add () {
  git add -A
}

function git_reset_branch () {
  git reset --hard "origin/$1"
}

# ================================== UTILITIES ==================================

function watchme () {
  cd functions || return 1
  npm run check && npm run build:watch
}

function npm_test_by_name () {
  if [ -z "$1" ]; then echo 'usage: npm_test_by_name "test name"' >&2; return 1; fi
  npm test -- -t "$1"
}

function npm_test_full () {
  npm test -- --maxWorkers=50%
}

function base64encode () {
  node -pe "Buffer.from(process.argv[1], 'utf8').toString('base64')" "$1"
}

function base64decode () {
  node -pe "Buffer.from(atob(process.argv[1]), 'latin1').toString('utf8')" "${1#*_}"
}

function timestamp () {
  if [ -z "$1" ]; then echo 'usage: timestamp "2026-08-11T10:00:00Z"' >&2; return 1; fi

  local out
  out=$(node -pe "new Date(isNaN(process.argv[1]) ? process.argv[1] : +process.argv[1])" "$1") || return 1
  echo "$out"
  printf '%s' "$out" | xclip -selection clipboard
}

# ================================== COMMANDS ==================================

alias ..="cd .."
alias ls="ls -la"
alias rm="rm -i"
alias swap_clear="sudo swapoff -a && sudo swapon -a"
alias flutter_clean_pub_cache="dart pub cache gc"

# ================================== UPDATERS ==================================

alias update_claude="curl -fsSL https://claude.ai/install.sh | bash"
alias update_codex="npm install -g @openai/codex"
alias update_agy="agy update"
alias update_firebase="npm install -g firebase-tools"
alias update_npm="npm install -g npm@latest"
alias update_flutter="flutter upgrade --force"
alias update_settings="curl -fsSL https://raw.githubusercontent.com/vndly/claude-code-settings/main/install.sh | bash"
alias update_bashrc="curl -fsSL https://raw.githubusercontent.com/vndly/bashrc/main/install.sh | bash"

# ================================== EXPORTS ==================================

export VISUAL=vim
export EDITOR=vim
export CLAUDE_CODE_EFFORT_LEVEL=max

export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
export FLUTTER_HOME="/opt/Flutter/bin"
export FLUTTER_PUB_HOME="$HOME/.pub-cache/bin"
export ANDROID_HOME="/opt/AndroidSdk"
export ANDROID_STUDIO_HOME="/opt/AndroidStudio"
export ANDROID_NDK_ROOT="/opt/AndroidSdk/ndk/28.2.13676358"
export ANDROID_NDK_HOME="$ANDROID_NDK_ROOT"

# Appends to PATH only if the directory exists and is not already there
function path_add () {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$PATH:$1" ;;
  esac
}

path_add "$FLUTTER_HOME"
path_add "$FLUTTER_PUB_HOME"
path_add "$ANDROID_HOME/platform-tools"
path_add "$ANDROID_HOME/cmdline-tools/latest/bin"
path_add "$ANDROID_HOME/emulator"
export PATH

# =================================== NVM ===================================

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# ================================== CLEAR ==================================

clear